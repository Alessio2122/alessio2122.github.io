---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);

const articleList = articles.map(article => ({
  id: article.id,
  data: article.data
}));

const recentArticles = articleList
  .sort((a, b) => new Date(b.data.datetime).getTime() - new Date(a.data.datetime).getTime())
  .slice(0, 6);
---

<Layout title="Alessio2122 - Lo que me interesa explicado a mi manera" description="¡Hola! Bienvenido/a a la página oficial de Alessio2122 (yo). Tecnología, programación, videojuegos y cualquier cosa que quiera contar estarán aquí. Bajo mis conocimientos, sin prisa." author="Alessio2122" datetime="2025-08-18" category="general">
    <div class="hero">
        <div class="hero-container">
            <h1 class="hero-title" style="justify-content: center;">Lo que me interesa explicado a mi manera</h1>
            <span class="splash-text" id="splash-text"></span>
            <p class="hero-text">¡Hola! Bienvenido/a a la página oficial de <strong>Alessio2122</strong> (yo).</p>
            <p class="hero-text">Tecnología, programación, videojuegos y cualquier cosa que quiera contar estarán aquí. Bajo mis conocimientos, sin prisa.</p>
            <div>
                <a href="/articles" class="button">Ver artículos recientes</a>
                <a href="/about" class="button button-secondary">Sobre Alessio2122</a>
            </div>
        </div>
    </div>
    <div class="main-content">
        <a href="/articles"><h2 id="artículos-recientes">Artículos recientes</h2></a>
        <div class="articles-grid">
            {recentArticles.map(article => (
                <a href={`/articles/${article.id}`} class="article-card" special="false">
                    <div class="article-header">
                        <span class="category">{article.data.category || 'General'}</span>
                        <time datetime={article.data.datetime}>{article.data.date || article.data.datetime.split('-').reverse().join('/')}</time>
                    </div>
                    <h3>{article.data.title}</h3>
                    <p class="dynamic-text-container">
                        <span class="dynamic-text">{article.data.description}</span>
                    </p>
                    <div class="article-author">Por: {article.data.author || 'Alessio2122'}</div>
                </a>
            ))}
        </div>
    </div>
</Layout>

