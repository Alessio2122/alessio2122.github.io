---
// Botones para compartir el artículo al final de la página.
// La URL del artículo se inyecta en cada enlace desde el cliente,
// así funcionan igual en desarrollo, producción o previsualización.
import { Copy } from '@lucide/astro';

interface Props {
    title: string;
}

const { title } = Astro.props as Props;
const encodedTitle = encodeURIComponent(title);
---

<div class="share-buttons" data-share-title={title}>
    <span class="share-label">Compartir:</span>
    <div class="share-buttons-list">
        <a class="share-btn" data-share="x" href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=`} target="_blank" rel="noopener noreferrer" title="Compartir en X (Twitter)" aria-label="Compartir en X (Twitter)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512"><path fill="currentColor" d="M357.2 48L427.8 48 273.6 224.2 455 464 313 464 201.7 318.6 74.5 464 3.8 464 168.7 275.5-5.2 48 140.4 48 240.9 180.9 357.2 48zM332.4 421.8l39.1 0-252.4-333.8-42 0 255.3 333.8z"/></svg>
        </a>
        <a class="share-btn" data-share="mastodon" href="#" role="button" aria-haspopup="dialog" title="Compartir en Mastodon" aria-label="Compartir en Mastodon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512"><path fill="currentColor" d="M433 179.1c0-97.2-63.7-125.7-63.7-125.7-62.5-28.7-228.6-28.4-290.5 0 0 0-63.7 28.5-63.7 125.7 0 115.7-6.6 259.4 105.6 289.1 40.5 10.7 75.3 13 103.3 11.4 50.8-2.8 79.3-18.1 79.3-18.1l-1.7-36.9s-36.3 11.4-77.1 10.1c-40.4-1.4-83-4.4-89.6-54-.6-4.6-.9-9.3-.9-13.9 85.6 20.9 158.7 9.1 178.7 6.7 56.1-6.7 105-41.3 111.2-72.9 9.8-49.8 9-121.5 9-121.5zM357.9 304.3l-46.6 0 0-114.2c0-49.7-64-51.6-64 6.9l0 62.5-46.3 0 0-62.5c0-58.5-64-56.6-64-6.9l0 114.2-46.7 0c0-122.1-5.2-147.9 18.4-175 25.9-28.9 79.8-30.8 103.8 6.1l11.6 19.5 11.6-19.5c24.1-37.1 78.1-34.8 103.8-6.1 23.7 27.3 18.4 53 18.4 175l0 0z"/></svg>
        </a>
        <a class="share-btn" data-share="facebook" href="https://www.facebook.com/sharer/sharer.php?u=" target="_blank" rel="noopener noreferrer" title="Compartir en Facebook" aria-label="Compartir en Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512"><path fill="currentColor" d="M512 256C512 114.6 397.4 0 256 0S0 114.6 0 256C0 376 82.7 476.8 194.2 504.5l0-170.3-52.8 0 0-78.2 52.8 0 0-33.7c0-87.1 39.4-127.5 125-127.5 16.2 0 44.2 3.2 55.7 6.4l0 70.8c-6-.6-16.5-1-29.6-1-42 0-58.2 15.9-58.2 57.2l0 27.8 83.6 0-14.4 78.2-69.3 0 0 175.9C413.8 494.8 512 386.9 512 256z"/></svg>
        </a>
        <a class="share-btn" data-share="whatsapp" href={`https://api.whatsapp.com/send?text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" title="Compartir en WhatsApp" aria-label="Compartir en WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512"><path fill="currentColor" d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        </a>
        <a class="share-btn" data-share="telegram" href={`https://t.me/share/url?url=&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" title="Compartir en Telegram" aria-label="Compartir en Telegram">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512"><path fill="currentColor" d="M256 8a248 248 0 1 0 0 496 248 248 0 1 0 0-496zM371 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5c-2.2 .5-37.1 23.5-104.6 69.1-9.9 6.8-18.9 10.1-26.9 9.9-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3 .6-4.5 6.7-9 18.4-13.7 72.3-31.5 120.5-52.3 144.6-62.3 68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9 2 1.7 3.2 4.1 3.5 6.7 .5 3.2 .6 6.5 .4 9.8z"/></svg>
        </a>
        <a class="share-btn" data-share="reddit" href={`https://www.reddit.com/submit?url=&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer" title="Compartir en Reddit" aria-label="Compartir en Reddit">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512"><path fill="currentColor" d="M0 256C0 114.6 114.6 0 256 0S512 114.6 512 256 397.4 512 256 512L37.1 512c-13.7 0-20.5-16.5-10.9-26.2L75 437C28.7 390.7 0 326.7 0 256zM349.6 153.6c23.6 0 42.7-19.1 42.7-42.7s-19.1-42.7-42.7-42.7c-20.6 0-37.8 14.6-41.8 34-34.5 3.7-61.4 33-61.4 68.4l0 .2c-37.5 1.6-71.8 12.3-99 29.1-10.1-7.8-22.8-12.5-36.5-12.5-33 0-59.8 26.8-59.8 59.8 0 24 14.1 44.6 34.4 54.1 2 69.4 77.6 125.2 170.6 125.2s168.7-55.9 170.6-125.3c20.2-9.6 34.1-30.2 34.1-54 0-33-26.8-59.8-59.8-59.8-13.7 0-26.3 4.6-36.4 12.4-27.4-17-62.1-27.7-100-29.1l0-.2c0-25.4 18.9-46.5 43.4-49.9 4.4 18.8 21.3 32.8 41.5 32.8l.1 .2zM177.1 246.9c16.7 0 29.5 17.6 28.5 39.3s-13.5 29.6-30.3 29.6-31.4-8.8-30.4-30.5 15.4-38.3 32.1-38.3l.1-.1zm190.1 38.3c1 21.7-13.7 30.5-30.4 30.5s-29.3-7.9-30.3-29.6 11.8-39.3 28.5-39.3 31.2 16.6 32.1 38.3l.1 .1zm-48.1 56.7c-10.3 24.6-34.6 41.9-63 41.9s-52.7-17.3-63-41.9c-1.2-2.9 .8-6.2 3.9-6.5 18.4-1.9 38.3-2.9 59.1-2.9s40.7 1 59.1 2.9c3.1 .3 5.1 3.6 3.9 6.5z"/></svg>
        </a>
        <a class="share-btn" data-share="linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=" target="_blank" rel="noopener noreferrer" title="Compartir en LinkedIn" aria-label="Compartir en LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 448 512"><path fill="currentColor" d="M416 32L31.9 32C14.3 32 0 46.5 0 64.3L0 447.7C0 465.5 14.3 480 31.9 480L416 480c17.6 0 32-14.5 32-32.3l0-383.4C448 46.5 433.6 32 416 32zM135.4 416l-66.4 0 0-213.8 66.5 0 0 213.8-.1 0zM102.2 96a38.5 38.5 0 1 1 0 77 38.5 38.5 0 1 1 0-77zM384.3 416l-66.4 0 0-104c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9l0 105.8-66.4 0 0-213.8 63.7 0 0 29.2 .9 0c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9l0 117.2z"/></svg>
        </a>
        <a class="share-btn" data-share="email" href={`mailto:?subject=${encodedTitle}&body=`} title="Compartir por correo electrónico" aria-label="Compartir por correo electrónico">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 512 512"><path fill="currentColor" d="M48 64c-26.5 0-48 21.5-48 48 0 15.1 7.1 29.3 19.2 38.4l208 156c17.1 12.8 40.5 12.8 57.6 0l208-156c12.1-9.1 19.2-23.3 19.2-38.4 0-26.5-21.5-48-48-48L48 64zM0 196L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-188-198.4 148.8c-34.1 25.6-81.1 25.6-115.2 0L0 196z"/></svg>
        </a>
        <button type="button" class="share-btn" data-share="copy" title="Copiar enlace" aria-label="Copiar enlace del artículo">
            <Copy size={16} />
        </button>
    </div>
    <span class="share-feedback" aria-live="polite"></span>
</div>

<!-- Selector de instancia para compartir en Mastodon -->
<dialog class="mastodon-dialog">
    <form method="dialog" class="mastodon-form">
        <p class="mastodon-title">Compartir en Mastodon</p>
        <label class="mastodon-field">
            <span>Tu instancia</span>
            <input type="text" name="instance" class="mastodon-input" placeholder="mastodon.social" autocomplete="off"
                spellcheck="false" autocapitalize="off" inputmode="url" list="mastodon-instances" required />
            <datalist id="mastodon-instances">
                <option value="mastodon.social"></option>
                <option value="masto.es"></option>
                <option value="mstdn.social"></option>
                <option value="fosstodon.org"></option>
            </datalist>
            <span class="mastodon-hint">Ej.: mastodon.social. La última instancia que uses quedará guardada en tu navegador.</span>
            <span class="mastodon-error" aria-live="polite"></span>
        </label>
        <div class="mastodon-actions">
            <button type="submit" value="cancel" class="mastodon-cancel">Cancelar</button>
            <button type="submit" value="share" class="mastodon-confirm">Compartir</button>
        </div>
    </form>
</dialog>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.share-buttons').forEach((container) => {
    const pageUrl = window.location.href.split('#')[0];
    const title = container.getAttribute('data-share-title') || document.title;
    const feedback = container.querySelector('.share-feedback');

    const showFeedback = (message) => {
      if (!feedback) return;
      feedback.textContent = message;
      setTimeout(() => { feedback.textContent = ''; }, 2000);
    };

    container.querySelectorAll('[data-share]').forEach((el) => {
      const network = el.getAttribute('data-share');

      // Botón de copiar enlace.
      if (network === 'copy') {
        el.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pageUrl);
            showFeedback('¡Enlace copiado!');
          } catch (err) {
            // Fallback para contextos sin Clipboard API (por ejemplo, HTTP).
            const aux = document.createElement('textarea');
            aux.value = pageUrl;
            aux.style.position = 'fixed';
            aux.style.opacity = '0';
            document.body.appendChild(aux);
            aux.select();
            try {
              document.execCommand('copy');
              showFeedback('¡Enlace copiado!');
            } catch {
              showFeedback('No se pudo copiar el enlace.');
            }
            aux.remove();
          }
        });
        return;
      }

      // Botón de Mastodon: abre el selector de instancia.
      if (network === 'mastodon') return;

      // Rellena los parámetros vacíos de cada enlace con la URL actual.
      const href = el.getAttribute('href') || '';
      const queryIndex = href.indexOf('?');
      const base = queryIndex === -1 ? href : href.slice(0, queryIndex);
      const params = new URLSearchParams(queryIndex === -1 ? '' : href.slice(queryIndex + 1));
      for (const key of [...params.keys()]) {
        if (params.get(key) === '') params.set(key, pageUrl);
      }
      if (network === 'whatsapp') {
        params.set('text', `${title} — ${pageUrl}`);
      }
      el.setAttribute('href', base + '?' + params.toString());
    });

    // Selector de instancia para Mastodon.
    const mastodonBtn = container.querySelector('[data-share="mastodon"]');
    const dialog = document.querySelector('.mastodon-dialog');
    if (mastodonBtn && dialog) {
      const form = dialog.querySelector('.mastodon-form');
      const input = dialog.querySelector('.mastodon-input');
      const errorEl = dialog.querySelector('.mastodon-error');
      const datalist = dialog.querySelector('#mastodon-instances');
      const confirmBtn = dialog.querySelector('.mastodon-confirm');
      const suggestions = ['mastodon.social', 'masto.es', 'mstdn.social', 'fosstodon.org'];

      const showError = (message) => {
        if (errorEl) errorEl.textContent = message;
        if (input) input.classList.add('mastodon-input-invalid');
      };
      const clearError = () => {
        if (errorEl) errorEl.textContent = '';
        if (input) input.classList.remove('mastodon-input-invalid');
      };

      // Normaliza lo introducido: acepta URL completa, @usuario@instancia o solo el dominio.
      const normalizeInstance = (raw) => {
        let value = (raw || '').trim().toLowerCase();
        value = value.replace(/^https?:\/\//, '').replace(/\/.*$/, '');
        if (value.startsWith('@')) {
          value = value.split('@').filter(Boolean).pop() || '';
        }
        return value;
      };

      const openDialog = () => {
        clearError();
        const last = localStorage.getItem('mastodon-instance');
        if (input) input.value = last || '';
        if (datalist) {
          const list = last ? [last, ...suggestions.filter(s => s !== last)] : suggestions;
          datalist.innerHTML = list.map(s => `<option value="${s}"></option>`).join('');
        }
        dialog.showModal();
        if (input) {
          input.focus();
          input.select();
        }
      };

      mastodonBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog();
      });

      if (input) {
        input.addEventListener('input', clearError);
      }

      // Cerrar con clic fuera del diálogo.
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

      form.addEventListener('submit', async (e) => {
        const action = e.submitter ? e.submitter.value : '';
        if (action !== 'share') return; // Cancelar: el formulario cierra el diálogo solo.
        e.preventDefault();
        if (!input) return;

        const instance = normalizeInstance(input.value);
        if (!instance || !instance.includes('.') || /\s/.test(instance)) {
          showError('Introduce un dominio válido, ej.: mastodon.social');
          return;
        }

        // Comprueba que la instancia exista y sea de Mastodon antes de abrir.
        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.textContent = 'Comprobando…';
        }
        let ok = false;
        try {
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 5000);
          const res = await fetch(`https://${instance}/api/v1/instance`, { signal: controller.signal });
          clearTimeout(timeout);
          if (res.ok) {
            const info = await res.json();
            ok = Boolean(info && (info.domain || info.uri || info.version));
          }
        } catch {
          ok = false;
        }
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Compartir';
        }
        if (!ok) {
          showError(`No se pudo conectar con ${instance}. Revisa el nombre de la instancia.`);
          return;
        }

        localStorage.setItem('mastodon-instance', instance);
        dialog.close();
        const shareUrl = `https://${instance}/share?text=${encodeURIComponent(`${title} — ${pageUrl}`)}`;
        window.open(shareUrl, '_blank', 'noopener,noreferrer');
      });
    }
  });
});
</script>
