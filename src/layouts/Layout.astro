---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description: string;
    author?: string;
    datetime: string;
    img?: string;
    category: string;
}

const { title, description, author, datetime, img, category } = Astro.props as Props;
const site = Astro.site || new URL('https://alessio2122.github.io');
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const ogImage = img ? new URL(img, site).toString() : new URL('/assets/logo.png', site).toString();
---

<html lang="es">
    <head>
        <title>{title === "Alessio2122 - Lo que me interesa explicado a mi manera" ? title : `${title} - Alessio2122`}</title>
        <link rel="stylesheet" href="/style.css">
        <link rel="icon" type="image/x-icon" href="/assets/logo.png">

        <meta name="description" content={description || "¡Hola! Bienvenido/a a la página oficial de Alessio2122 (yo). Tecnología, programación, videojuegos y cualquier cosa que quiera contar estarán aquí. Bajo mis conocimientos, sin prisa."}/>
        <meta name="author" content={author || "Alessio2122"}/>
        <meta name="date" content={datetime}/>
        <meta name="keywords" content={`${category || "general"}, ${title}, ${description}, Alessio2122, Minecraft, Redstone, programación, invenciones, ideas`}/>
        <meta property="og:title" content={title === "Alessio2122 - Lo que me interesa explicado a mi manera" ? title : `${title} - Alessio2122`}/>
        <meta property="og:description" content={description || "¡Hola! Bienvenido/a a la página oficial de Alessio2122 (yo). Tecnología, programación, videojuegos y cualquier cosa que quiera contar estarán aquí. Bajo mis conocimientos, sin prisa."}/>
        <meta property="og:image" content={ogImage}/>
        <meta property="og:url" content={canonicalURL}/>
        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content={title === "Alessio2122 - Lo que me interesa explicado a mi manera" ? title : `${title} - Alessio2122`}/>
        <meta name="twitter:description" content={description || "¡Hola! Bienvenido/a a la página oficial de Alessio2122 (yo). Tecnología, programación, videojuegos y cualquier cosa que quiera contar estarán aquí. Bajo mis conocimientos, sin prisa."}/>
        <meta name="twitter:image" content={ogImage}/>
        <meta name="twitter:creator" content={author || "Alessio2122"}/>
        <meta name="theme-color" content="#3959d5">
        <link rel="canonical" href={canonicalURL}/>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
        <Header />
        <slot />
        <Footer />
    </body>
</html>